<?xml version="1.0" encoding="utf-8"?>
<!-- Memphis card: a hard ink shadow 6dp down-right, no blur (this design has no soft edges). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aivin_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aivin_surface" />
            <stroke android:width="3dp" android:color="@color/aivin_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
