<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        No action bar: the window is edge-to-edge (forced from Android 15 on), and an AppCompat
        action bar does not pad the content below it by the status bar. The layout draws its own
        title and MainActivity applies the insets.
    -->
    <style name="Theme.AivinNet" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/aivin_teal</item>
        <item name="colorAccent">@color/aivin_teal</item>
        <item name="colorControlActivated">@color/aivin_teal</item>
        <item name="android:windowBackground">@color/aivin_ground</item>
        <item name="android:textColorPrimary">@color/aivin_text</item>
        <item name="android:textColorSecondary">@color/aivin_text_muted</item>
    </style>

    <!-- Parent of the dotted names below (Aivin.Heading inherits from Aivin implicitly). -->
    <style name="Aivin" />

    <!-- Section heading on a card. -->
    <style name="Aivin.Heading">
        <item name="android:textColor">@color/aivin_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small bold label above a field. -->
    <style name="Aivin.Label">
        <item name="android:textColor">@color/aivin_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Aivin.Body">
        <item name="android:textColor">@color/aivin_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Paper field with an ink line; the focus ring turns teal. -->
    <style name="Aivin.Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/aivin_text</item>
        <item name="android:textColorHint">@color/aivin_text_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- The candy button: fill, ink line, hard offset shadow that it presses into. -->
    <style name="Aivin.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/aivin_on_accent</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Aivin.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/aivin_text</item>
    </style>

    <!-- A card: surface, ink line, hard shadow 6dp down-right (the padding keeps content off it). -->
    <style name="Aivin.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:paddingBottom">26dp</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>
</resources>
