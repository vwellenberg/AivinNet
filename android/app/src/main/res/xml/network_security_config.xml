<?xml version="1.0" encoding="utf-8"?>
<!--
  Home servers on the LAN run plain HTTP (default port 1970), so cleartext has to
  be allowed. Requests to the server are only ever made to the URL the user typed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
